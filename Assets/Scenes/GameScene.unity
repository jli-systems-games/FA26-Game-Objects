MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 971260366}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f553d6ffa03804636a6e8eb25ce66cb9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SphereDialogue
  lines:
  - Yo.
  - You just went through everything.
  - Thank you for listening this whole time.
  - Green Seafoo wants to thank you for playing this too.
  - So, as you can see, there's a door here.
  - You know in every game if you jump into the void you die right?
  - It's the same here.
  - If you cherish your life, please don't jump down.
  - But if you are suicidal enough to still do so, I'll catch you.
--- !u!64 &971260368
