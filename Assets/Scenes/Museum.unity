  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d49fed5d5a60f2548b3fa318fbaabf31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Artifact
  artifactName: Gold Key
  description: "\nBrass plating. Souvenir, bought at a theme park.\n\nIt doesn\u2019t
    open anything. I knew that at the time.\n\nBut I believed there was a door somewhere
    waiting to be opened, and that I needed the key first, before I would find it.
    So I kept it for years, waiting for the door to show up.\n\nI don\u2019t remember
    anymore what I was waiting for. The key is still here."
  normalMaterial: {fileID: 2100000, guid: 0959931499b85c147af7edc04cf40b88, type: 2}
  highlightMaterial: {fileID: 2100000, guid: e19053c65c8cd0d4b914a93f83d715b7, type: 2}
