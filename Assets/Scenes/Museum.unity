--- !u!114 &1733937070
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1733937065}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d49fed5d5a60f2548b3fa318fbaabf31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Artifact
  artifactName: Owl Necklace
  description: "\nMetal, coating worn off.\n\nI thought I would transform when I
    wore it. Not as a metaphor \u2014 I thought that if I ran around a corner with
    it on, there would be light, and I would become one of those characters. I tried
    many times. I never stopped to ask why it didn\u2019t work. I assumed it just
    wasn\u2019t time yet.\n\nThe coating wore off in my pocket. I carried it everywhere."
  normalMaterial: {fileID: 2100000, guid: 33e22f6f12c14f8479c7a4ffb6c442a7, type: 2}
  highlightMaterial: {fileID: 2100000, guid: 1dbd5805613293344b9c7aa090f32de9, type: 2}
