  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Artifact
  artifactName: A Song
  description: "\nThree minutes, forty seconds.\n\nI played it on loop for an entire
    trip. I wasn\u2019t paying attention to it. I was looking out a window.\n\nNow
    the first four seconds put me back in that seat, at that hour, in that light.
    I can\u2019t get there any other way."
  normalMaterial: {fileID: 2100000, guid: bed23568c32fbcb44a31a4e4f01eed0e, type: 2}
  highlightMaterial: {fileID: 2100000, guid: 7222cf2a9fb40e44da5784b6cc8f1742, type: 2}
