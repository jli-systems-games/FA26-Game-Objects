  m_Script: {fileID: 11500000, guid: d49fed5d5a60f2548b3fa318fbaabf31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Artifact
  artifactName: A Photograph
  description: "\nPrinted, corner bent.\n\nI don\u2019t remember the day. I remember
    that I was happy in it, because I can see that I was.\n\nThis is the part I find
    strange: the photo is the only reason I know it happened. Without it, that day
    is simply not in me."
  normalMaterial: {fileID: 2100000, guid: e48c25b6305c3044aa12ea9b0fb3643f, type: 2}
  highlightMaterial: {fileID: 2100000, guid: 93917e8cd0f9cf941937897ed05578ad, type: 2}
