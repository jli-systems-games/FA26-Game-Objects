  m_Script: {fileID: 11500000, guid: d49fed5d5a60f2548b3fa318fbaabf31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Artifact
  artifactName: I Forgot, Until
  description: "I don't have a bad memory. I'm just too full.\r\n\r\nThe old things
    didn't disappear. They were pushed to the back, waiting for something to wake
    them.\r\n\r\nA pin, a page, a song, a smell \u2014 what they bring back is the
    same.\r\n\r\nStart anywhere."
