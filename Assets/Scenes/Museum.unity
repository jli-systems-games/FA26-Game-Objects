  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d49fed5d5a60f2548b3fa318fbaabf31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Artifact
  artifactName: Eye Pendant
  description: "\nPlastic. Cord broken.\n\nAn eye. I never knew what it was supposed
    to mean and I never looked it up.\n\nI treated it as protection. Before tests,
    the day I changed schools, nights I slept alone \u2014 I would hold it. It had
    no power, and I knew that. But I felt better holding it, and feeling better is
    its own kind of power."
  normalMaterial: {fileID: 2100000, guid: 138e921542287dd479499e5c72d57d41, type: 2}
  highlightMaterial: {fileID: 2100000, guid: 3f8764fb41a1f8543bb55251df5519a9, type: 2}
