--- !u!114 &1413857487
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1413857484}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d49fed5d5a60f2548b3fa318fbaabf31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Artifact
  artifactName: Omamori
  description: "\nCloth and paper. Bought in Japan. Still sealed.\n\nI hit my head
    once and didn\u2019t want to make it a problem. That night it hurt and I lay
    awake and became very afraid of dying.\n\nSo I wrote something and put it inside
    this.\n\nI\u2019ve never taken it out. I don\u2019t remember what I wrote. I
    remember deciding that writing it down would work."
  normalMaterial: {fileID: 2100000, guid: e26f48fbf409371449a3707cac7ac459, type: 2}
  highlightMaterial: {fileID: 2100000, guid: 5a33cc2be4c67fd4bb312572a9982684, type: 2}
