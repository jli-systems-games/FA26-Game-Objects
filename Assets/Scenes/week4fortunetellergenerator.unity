  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NewMonoBehaviourScript
  titleText: {fileID: 797915423}
  AltTitles:
  - '1. Cecropia Moth: Adult moths live for just 1 to 2 weeks :('
  - '2. Wolly Worm: Doesn''t identify as a worm or bear'
  - '3. Tortoise Beetle: Once they die, their fluids dry up'
  - '4. Horseshoe crab: They crush their food between their legs before eating'
  - '5. Orchid Mantis: They are tiny but surprisingly effective assassins >:)'
  - '6. Isopod: Can drink water through their rear ends'
  - '7. Weevil: There are over 60,000 species of weevils :O'
  - '8. Dirona: Can reach a length of about 180 mm (7.1 in)'
  newTitle: 
