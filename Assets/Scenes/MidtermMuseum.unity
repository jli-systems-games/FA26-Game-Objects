  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumExhibit
  title: Perseverance Rover
  meta: "NASA/JPL-Caltech  \xB7  Landed in Jezero Crater, 18 February 2021"
  body: "Perseverance is a car-sized robot geologist searching for signs of ancient
    life and collecting rock samples for a future return to Earth. On board, the
    MOXIE experiment turned carbon dioxide from the Martian air into breathable oxygen
    \u2014 a small test of how future settlers could make what they need on site."
  themeLink: 'The journey that started with a phone in your hand ends here: the same
    chips, cameras and sensors, now working on another planet to make human life
    there possible.'
  credit: 'Model: Mars Perseverance Rover 3D model, NASA/JPL-Caltech (science.nasa.gov).'
  interactPoint: {fileID: 0}
  interactRange: 4.2
  model: {fileID: 0}
  sway: 0
