  m_Script: {fileID: 11500000, guid: a8c78a3dc61624f33b78b8b42697355c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumExhibit
  title: Perseverance Rover
  meta: "Recovered from Jezero Crater, Mars  \xB7  Landed 18 February 2021  \xB7 
    NASA/JPL-Caltech"
  body: 'Perseverance was a car-sized robot geologist, sent to search for signs of
    ancient life and to collect rock samples. On board, the MOXIE experiment turned
    carbon dioxide from the Martian air into breathable oxygen, a small test of how
    settlers might make what they needed on another world.


    We found it still
    standing on Mars, long after its makers were gone.'
  themeLink: 'The journey that began with a phone in a human hand ends here: the
    same chips, cameras and sensors, working on another planet. Their machines travelled
    further than they did.'
  credit: 'Model: Mars Perseverance Rover 3D model, NASA/JPL-Caltech (science.nasa.gov).'
  image: {fileID: 0}
  interactPoint: {fileID: 0}
  interactRange: 4.2
  model: {fileID: 701882639}
  idleSpin: 6
