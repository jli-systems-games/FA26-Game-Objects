--- !u!114 &1713466135
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1713466133}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8c78a3dc61624f33b78b8b42697355c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumExhibit
  title: 'Turntable: Sounds of Earth'
  meta: "Lobby  \xB7  Choose a record  \xB7  Voyager Golden Records launched 1977"
  body: 'For most of the 20th century, music lived on vinyl: a groove cut into a
    disc, read by a needle. Listening meant owning a physical object and a machine
    to play it. Today the same songs travel invisibly to the phone in your pocket.


    In
    1977 NASA sent two gold-plated records into space on Voyager 1 and 2, carrying
    greetings, sounds and music from Earth for anyone who might find them.'
  themeLink: "This museum starts where Voyager's record ends: technology carrying
    human life outward. Pick a record \u2014 it keeps playing while you explore."
  credit: "Model: \"Turntable with stands and speakers\" by charliebrown, CC BY 4.0,
    via Sketchfab. Music (CC0, OpenGameArt): Starfield Romance \u2013 Yoiyami; Steller
    Dreams \u2013 Synth-thetic; Floating in Space \u2013 Umplix. Record 4: Aphex
    Twin \u2013 \"#21\" (copyright the artist/label; used without a licence in a
    non-commercial student project)."
  interactPoint: {fileID: 0}
  interactRange: 3.2
  model: {fileID: 0}
  sway: 0
  swayAngle: 28
  screen: {fileID: 0}
  focusHighlight: {fileID: 1853895858}
  keepModeOnOpen: 0
  onModeChanged:
    m_PersistentCalls:
      m_Calls: []
  musicSource: {fileID: 1713466136}
  modes:
  - label: Aphex Twin  #21
    caption: "Record 1 \u2014 Aphex Twin, '#21'. Ambient electronic music made with
      synthesizers like the one next to this turntable. Press 1 again to stop."
    screenColor: {r: 1, g: 1, b: 1, a: 1}
    showObject: {fileID: 0}
    lift: 0
    spinSpeed: 18
    music: {fileID: 8300000, guid: db998bfbafb9b47748cdc3957154c6f0, type: 3}
  - label: Starfield Romance
    caption: "Record 2 \u2014 'Starfield Romance' by Yoiyami (CC0). Soft piano for
      the lobby. Press 2 again to stop."
    screenColor: {r: 1, g: 1, b: 1, a: 1}
    showObject: {fileID: 0}
    lift: 0
    spinSpeed: 18
    music: {fileID: 8300000, guid: fa4286477662e43a0b033789fd5928c2, type: 3}
  - label: Steller Dreams
    caption: "Record 3 \u2014 'Steller Dreams' by Synth-thetic (CC0). Slow synths,
      like drifting in orbit. Press 3 again to stop."
    screenColor: {r: 1, g: 1, b: 1, a: 1}
    showObject: {fileID: 0}
    lift: 0
    spinSpeed: 18
    music: {fileID: 8300000, guid: cfaad47069b6247ea910ee4e0c2dafde, type: 3}
  - label: Floating in Space
    caption: "Record 4 \u2014 'Floating in Space' by Umplix (CC0). Pure ambience.
      Press 4 again to stop."
