  m_Script: {fileID: 11500000, guid: a8c78a3dc61624f33b78b8b42697355c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumExhibit
  title: Modular Synthesizer
  meta: "Electronic instrument  \xB7  Modular synthesizers spread in the mid-1960s"
  body: 'A synthesizer makes sound from electricity instead of strings, reeds or
    skins. Oscillators create waves, filters shape them, and patch cables connect
    the modules in endless combinations.


    When Robert Moog and others began
    selling modular systems in the 1960s, these machines moved from laboratories
    into studios. Electronic sound soon became the sound people imagined for the
    future, for robots and for space.'
  themeLink: "The turntable stores human music; the synthesizer invents sounds that
    never existed. Technology does not only record our lives \u2014 it changes what
    they sound like."
  credit: 'Model: "Gary''s Synthesizer" by Fredrik (kird3rf), CC BY 4.0, via Sketchfab.'
  interactPoint: {fileID: 0}
  interactRange: 2.8
  model: {fileID: 0}
  sway: 0
  swayAngle: 28
  screen: {fileID: 0}
  focusHighlight: {fileID: 830431539}
  keepModeOnOpen: 0
  onModeChanged:
    m_PersistentCalls:
      m_Calls: []
  musicSource: {fileID: 0}
  modes: []
