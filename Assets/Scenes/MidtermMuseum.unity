  m_Script: {fileID: 11500000, guid: a8c78a3dc61624f33b78b8b42697355c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumExhibit
  title: Landing on Mars
  meta: "Stylised lander  \xB7  First successful Mars landing: Viking 1, 20 July
    1976"
  body: 'Landing on Mars is famously hard: the air is too thin to slow a spacecraft
    easily, but thick enough to burn it. Landers combine heat shields, parachutes
    and rockets in a few minutes known as the ''seven minutes of terror''. Every
    future settlement depends on getting this right.'
  themeLink: Before anyone can live on Mars, machines have to arrive safely and prepare
    the way. This is the doorway to the final room.
  credit: 'Model: "Lander B" by Kay Lousberg, CC0, via Poly Pizza. Stylised, not
    a model of a real mission.'
  interactPoint: {fileID: 0}
  interactRange: 3
  model: {fileID: 0}
  sway: 0
  swayAngle: 28
  screen: {fileID: 0}
