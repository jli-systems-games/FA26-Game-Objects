  m_Script: {fileID: 11500000, guid: a8c78a3dc61624f33b78b8b42697355c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumExhibit
  title: 'Piano: Sounds of Earth'
  meta: "Lobby \xB7 Classical listening station"
  body: "An acoustic piano turns touch into vibration: keys drive hammers against
    strings.\n\nChoose a performance with 1\u20133. Press the same selection again,
    or 4, to stop. Close the panel to watch the screen. Moving away stops playback.\n\nThree
    local concert recordings are available. The Fedorova recording plays only the
    first movement (00:05\u201311:37)."
  themeLink: Long before humans sent their voices into space, these instruments carried
    their emotions across a room.
  credit: 'Piano: Rigged, Cell-Shaded Grand Piano by Stekapinko, via Sketchfab, CC
    Attribution. Adapted: Unity materials, scale and decorative key motion.

    https://sketchfab.com/3d-models/rigged-cell-shaded-grand-piano-e9f77ab00f204dbeb046f17c553ec071

    Performance
    recordings supplied by project owner.'
  image: {fileID: 0}
  interactPoint: {fileID: 0}
  interactRange: 3.3
  model: {fileID: 0}
  idleSpin: 10
  sway: 0
  swayAngle: 28
  screen: {fileID: 0}
  focusHighlight: {fileID: 0}
  keepModeOnOpen: 1
  onModeChanged:
    m_PersistentCalls:
      m_Calls: []
  musicSource: {fileID: 0}
  modes:
  - label: "Rachmaninoff \xB7 I"
    caption: "Piano Concerto No. 2 \u2014 I. Moderato. Anna Fedorova. Local media
      required if the screen reports missing media."
    screenColor: {r: 0, g: 1, b: 1, a: 1}
    showObject: {fileID: 0}
    lift: 0
    spinSpeed: 0
    music: {fileID: 0}
  - label: "Rachmaninoff \xB7 II"
    caption: "Piano Concerto No. 2 \u2014 II. Adagio sostenuto. Khatia Buniatishvili."
    screenColor: {r: 0, g: 1, b: 1, a: 1}
    showObject: {fileID: 0}
    lift: 0
    spinSpeed: 0
    music: {fileID: 0}
  - label: "Mahler \xB7 IV"
    caption: "Symphony No. 5 \u2014 IV. Adagietto. Leonard Bernstein, Vienna Philharmonic,
      1973. Local media required if the screen reports missing media."
    screenColor: {r: 0, g: 1, b: 1, a: 1}
    showObject: {fileID: 0}
    lift: 0
    spinSpeed: 0
