  m_Script: {fileID: 11500000, guid: a8c78a3dc61624f33b78b8b42697355c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumExhibit
  title: Boeing 757 Flight Deck
  meta: "Airliner cockpit  \xB7  Boeing 757 first flew in 1982, entered service 1983"
  body: 'The 757 was one of the first airliners designed from the start for a crew
    of two. Alongside classic dials, its flight deck used colour screens to show
    attitude, navigation and engine data, with computers sharing the work of flying.


    Aeroplanes
    like this made crossing oceans an ordinary weekend trip. For most people, flying
    is the closest they will come to leaving the ground.'
  themeLink: "Before rockets, the aeroplane made the sky routine. The same story
    you saw on the phone \u2014 buttons and dials turning into screens, humans trusting
    computers \u2014 continues on the way to space."
  credit: 'Model: "Boeing 757-200 Icelandair Cockpit" by VTX, CC BY-NC-SA 4.0, via
    Sketchfab. Used non-commercially in a student project.'
  interactPoint: {fileID: 0}
  interactRange: 4.4
  model: {fileID: 0}
  sway: 0
