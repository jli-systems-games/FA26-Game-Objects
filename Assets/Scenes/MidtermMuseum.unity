  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8c78a3dc61624f33b78b8b42697355c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumExhibit
  title: The Suit as a Spacecraft
  meta: "Recovered in orbit  \xB7  First moonwalk: Apollo 11, 20 July 1969"
  body: 'A spacesuit was the most personal machine humans ever built. It supplied
    oxygen, removed carbon dioxide, held pressure, controlled temperature and shielded
    its wearer from radiation and dust: a tiny spacecraft shaped like a human.


    The
    suit beside this plinth is complete. Choose "Try on the suit" to see how it fits
    a body that is not human.'
  themeLink: Wearables measured the body; the suit replaced the planet around it.
    To leave Earth, humans had to carry a piece of it with them.
  credit: 'Models: "Space Helmet - Model 1b" by Alan Zimmerman, CC BY 3.0 (Poly Pizza);
    "Astronaut by Jungle Jim", CC BY 4.0 (Sketchfab).'
  image: {fileID: 0}
  interactPoint: {fileID: 0}
  interactRange: 3
  model: {fileID: 915421935}
  idleSpin: 12
  sway: 0
  swayAngle: 28
  screen: {fileID: 0}
  focusHighlight: {fileID: 1972815889}
  keepModeOnOpen: 1
  onModeChanged:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1709524858}
        m_TargetAssemblyTypeName: MuseumWearableSuit, Assembly-CSharp
        m_MethodName: OnModeChanged
        m_Mode: 0
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  musicSource: {fileID: 0}
  modes:
  - label: Stay an alien
    caption: You look at the suit from outside, as a visitor from elsewhere.
    screenColor: {r: 1, g: 1, b: 1, a: 1}
    showObject: {fileID: 0}
    lift: 0
    spinSpeed: 18
    music: {fileID: 0}
  - label: Try on the suit
    caption: You are wearing a human spacesuit. Press V to see yourself in third
      person. Choose 1 to take it off.
    screenColor: {r: 1, g: 1, b: 1, a: 1}
    showObject: {fileID: 0}
    lift: 0
    spinSpeed: 18
    music: {fileID: 0}
