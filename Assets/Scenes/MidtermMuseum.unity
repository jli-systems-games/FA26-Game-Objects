  m_Script: {fileID: 11500000, guid: 55d86ba0de3ec4d1b8941bc9d5db7e0f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumAlienNPC
  lines:
  - They stared at this rectangle seven hours a day. Our scholars believe it was
    staring back.
  - Every human carried one. None of them could explain how it worked.
  - I pressed the glass. It asked me for a "passcode". Rude.
  talkRange: 3.6
  voicePitch: 1
  bubbleHeight: 1.9
  floats: 0
  animator: {fileID: 1020780056}
